{
    "name": "sofyco/security-validation-bundle",
    "type": "symfony-bundle",
    "version": "3.0.0",
    "description": "Security Validation Constraints",
    "keywords": ["php", "symfony", "bundle", "security", "validation", "constraints"],
    "homepage": "https://github.com/sofyco/security-validation-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Sofiia Korzhova",
            "email": "sofykorzhova@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-intl": "*",
        "php-http/discovery": "^1.20",
        "symfony/framework-bundle": "^8.0",
        "symfony/security-bundle": "^8.0",
        "symfony/validator": "^8.0",
        "usarise/turnstile": "^0.7"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.4"
    },
    "autoload": {
        "psr-4": {
            "Sofyco\\Bundle\\SecurityValidationBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sofyco\\Bundle\\SecurityValidationBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    }
}
